DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ifc_bim_viewer?schema=public"

IFC_MAX_UPLOAD_MB="250"
IFC_PROCESSING_MAX_ATTEMPTS="3"
IFC_PROCESSING_STALE_MINUTES="15"
IFC_WORKER_API_BASE="https://ifc-upload-bim-viewer.vercel.app"
IFC_WORKER_TOKEN="change-me"
IFC_WORKER_POLL_INTERVAL_MS="5000"

# Korea Meteorological Administration short-term forecast API.
# Apply for "기상청_단기예보 조회서비스" on data.go.kr and paste the service key.
# KMA_SERVICE_KEY="..."

# NAVER Developers Search API for project location search.
# Register an application with Search API permission, then paste the keys.
# NAVER_SEARCH_CLIENT_ID="..."
# NAVER_SEARCH_CLIENT_SECRET="..."

# Derivative/object storage. LOCAL is for development only.
OBJECT_STORAGE_PROVIDER="LOCAL"
LOCAL_OBJECT_STORAGE_DIR="object-storage"

# S3/R2 compatible settings.
# OBJECT_STORAGE_PROVIDER="R2"
# OBJECT_STORAGE_BUCKET="your-bucket"
# OBJECT_STORAGE_REGION="auto"
# OBJECT_STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# OBJECT_STORAGE_ACCESS_KEY_ID="..."
# OBJECT_STORAGE_SECRET_ACCESS_KEY="..."
# OBJECT_STORAGE_FORCE_PATH_STYLE="false"

# GCS settings use Application Default Credentials.
# OBJECT_STORAGE_PROVIDER="GCS"
# OBJECT_STORAGE_BUCKET="your-bucket"

# Vercel Blob.
# BLOB_STORE_ID="store_..."
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Autodesk Platform Services for NWC/NWD -> SVF2 viewer conversion.
# Create an APS app with Data Management and Model Derivative APIs enabled.
# APS_CLIENT_ID="..."
# APS_CLIENT_SECRET="..."
# APS_BUCKET_KEY="your-globally-unique-bucket-key"
# APS_BUCKET_SUFFIX="bim-viewer"
# APS_REGION="US"

# Optional original IFC archive policy. When enabled, the worker uploads the
# original IFC to Google Drive after fragment conversion, then asks the app API
# to delete the original Blob object. The viewer still loads .frag from Blob.
# ORIGINAL_STORAGE_POLICY="archive-to-drive-delete-blob"
# GOOGLE_DRIVE_CLIENT_ID="..."
# GOOGLE_DRIVE_CLIENT_SECRET="..."
# GOOGLE_DRIVE_REFRESH_TOKEN="..."
# GOOGLE_DRIVE_ARCHIVE_FOLDER_ID="..."
# GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/oauth2callback"
# GOOGLE_DRIVE_SCOPE="https://www.googleapis.com/auth/drive.file"
